{
  "name": "receipt-agent",
  "type": "ai-agent",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "receipt-agent",
  "entrypoint": "deployment/ai-agent",
  "exposure": "internet",
  "stories": [
    3
  ],
  "description": "Reads an uploaded receipt photo or PDF and proposes the merchant, date and total for the employee to review and correct. A single-turn extraction: it calls no other component, stores nothing beyond its own transcript, and never guesses a field it cannot confidently read — it leaves that field blank instead.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "expense-tracker-t-ca8c5f1d",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "agent-building",
    "thunder-authentication"
  ]
}
