{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "description": "The single-page app an employee uses to sign in, upload a receipt, review/correct the auto-extracted fields, save the expense, and see their own expense list with a running total. Holds no business logic of its own beyond form handling and calls to expense-api and receipt-agent.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "description": "Saves and lists the signed-in employee's own expenses.",
      "wiring": {
        "endpoint": {
          "component": "expense-tracker-team-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "component",
      "name": "receipt-agent",
      "description": "Extracts merchant, date and total from an uploaded receipt before the employee corrects and saves it.",
      "wiring": {
        "endpoint": {
          "component": "expense-tracker-team-receipt-agent",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "RECEIPT_AGENT_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "expense-tracker-t-ca8c5f1d",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
